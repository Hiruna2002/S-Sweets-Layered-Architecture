      </Button>
      <Button fx:id="btnShow" layoutX="855.0" layoutY="152.0" mnemonicParsing="false" onAction="#btnShowOnNavigateTo" prefHeight="44.0" prefWidth="103.0" style="-fx-background-radius: 30px; -fx-background-color: lightgray;" text="Show">
