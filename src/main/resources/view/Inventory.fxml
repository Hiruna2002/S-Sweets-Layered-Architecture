               <font>
                  <Font name="DejaVu Serif Condensed Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
      <Button fx:id="btnSave" layoutX="855.0" layoutY="95.0" mnemonicParsing="false" onAction="#btnSaveOnNavigateTo" prefHeight="46.0" prefWidth="103.0" style="-fx-background-radius: 30px; -fx-background-color: lightgray;" text="Save">
