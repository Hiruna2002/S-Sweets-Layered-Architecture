      <HBox layoutX="75.0" layoutY="303.0" prefHeight="68.0" prefWidth="531.0" spacing="35.0" />
      <TableView fx:id="tblInventory" layoutX="45.0" layoutY="333.0" onMouseClicked="#onClickTable" prefHeight="305.0" prefWidth="1004.0">
        <columns>
          <TableColumn fx:id="colInvenId" prefWidth="318.0" text="InvenId" />
          <TableColumn fx:id="colIngId" prefWidth="373.0" text="IngId" />
